      "roundness": null,
      "seed": 390230,
      "version": 1,
      "versionNonce": 497591,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "v1 的标准很朴素：能跑通；v2 的标准才是更稳、更可配、更能展示。",
      "fontSize": 24,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "v1 的标准很朴素：能跑通；v2 的标准才是更稳、更可配、更能展示。",
      "lineHeight": 1.25,
      "autoResize": true
