      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "先把输出结构固定下来，后面接 Notion、函数调用和测试都会轻松很多。",
      "fontSize": 24,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "先把输出结构固定下来，后面接 Notion、函数调用和测试都会轻松很多。",
      "lineHeight": 1.25,
      "autoResize": true
