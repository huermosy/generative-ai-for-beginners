      "updated": 1,
      "link": null,
      "locked": false,
      "text": "W2D4 的 Prompt 不该只是“随便问一句”，而要把 W2D2 的模板意识真正落进应用代码里。",
      "fontSize": 24,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "W2D4 的 Prompt 不该只是“随便问一句”，而要把 W2D2 的模板意识真正落进应用代码里。",
      "lineHeight": 1.25,
      "autoResize": true
    },
    {
      "id": "text-1ex92epg",
      "type": "text",
      "x": 90,
      "y": 720,
      "width": 0,
